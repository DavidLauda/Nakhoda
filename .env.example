# Supabase Project Settings > API Keys. Use sb_publishable_... in the browser, never sb_secret_....
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hackathon quick login uses Supabase Anonymous Sign-Ins. Enable both flags only for the judging window.
NEXT_PUBLIC_QUICK_LOGIN_ENABLED=false
QUICK_LOGIN_FULL_ACCESS=false
# Trusted Next.js server and GitHub Actions only. Never prefix with NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=http://localhost:3000
# Optional licensed MapLibre style URL; without it the list/map fallback still works.
NEXT_PUBLIC_MAP_STYLE_URL=
# Dedicated team Gmail account and OAuth client with gmail.send scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
EMAIL_SENDER=
EMAIL_MODE=test
# Comma-separated inboxes owned by the team. Empty blocks all sends.
EMAIL_TEST_ALLOWLIST=
# Pipeline secrets in GitHub Actions, never exposed to the PWA.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
